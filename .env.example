# =============================================================================
# Formula E Fantasy — environment configuration
#
# Copy to `.env` for local development. On Railway, set these as service
# variables instead; `.env` is gitignored and never deployed.
#
# Everything below has a default in app/config.py except SECRET_KEY and
# DATABASE_URL, which production refuses to start without.
# =============================================================================

# --- Flask -------------------------------------------------------------------
FLASK_ENV=development                  # development | testing | production
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5000     # must be https:// in production
SESSION_LIFETIME_DAYS=30
DISPLAY_TIMEZONE=Europe/London

# --- Database ----------------------------------------------------------------
# Railway injects DATABASE_URL automatically once Postgres is attached.
# The psycopg 3 driver is applied in config.py; supply a plain URL here.
DATABASE_URL=postgresql://fe_user:fe_pass@localhost:5432/fe_fantasy
TEST_DATABASE_URL=postgresql://fe_user:fe_pass@localhost:5432/fe_fantasy_test
DB_POOL_RECYCLE_SECONDS=300

# --- Email (Resend). Password reset only. ------------------------------------
# Leave RESEND_API_KEY empty in development: the reset link is logged to the
# console instead, which is enough to complete the flow end to end.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@fe.kitsniff.com
RESEND_FROM_NAME=Formula E Fantasy
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# --- Rate limiting (per process; see SPEC.md §7) ------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_MINUTES=60
REGISTER_BLOCK_MINUTES=60

# --- Leagues (Phase 6) --------------------------------------------------------
INVITE_CODE_LENGTH=6
INVITE_CODE_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789
MAX_LEAGUE_MEMBERS=50

# --- Admin --------------------------------------------------------------------
ACTIVE_USER_WINDOW_DAYS=30

# --- Orange Cat Blacktop API (Phase 1; unused in Phase 0) ---------------------
# The User-Agent is not optional. The default Python UA is refused by
# Cloudflare with Error 1010 before the API ever sees the request.
OCB_BASE_URL=https://api.ocblacktop.com/v1/formula-e
OCB_API_KEY=
OCB_REQUEST_TIMEOUT_SECONDS=15
OCB_MIN_REQUEST_INTERVAL_SECONDS=0.5
